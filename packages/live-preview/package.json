{
  "name": "@localess/live-preview",
  "version": "4.0.0",
  "description": "Framework-neutral Visual Editor bridge for Localess — sync script loading, editable attributes, and editor events.",
  "keywords": [
    "localess",
    "sdk",
    "visual-editor",
    "live-preview",
    "javascript",
    "typescript"
  ],
  "author": "Lessify",
  "homepage": "https://github.com/Lessify/localess-js",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lessify/localess-js.git",
    "directory": "packages/live-preview"
  },
  "bugs": {
    "url": "https://github.com/Lessify/localess-js/issues"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@localess/model": "*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.0"
  },
  "engines": {
    "node": ">= 24.0.0"
  }
}
