---
import {
  type LocalessRichTextInput,
  type LocalessRichTextRenderers,
  renderRichTextToHtml,
} from '../richtext';

export interface Props {
  content: LocalessRichTextInput;
  renderers?: LocalessRichTextRenderers<string>;
}

const { content, renderers } = Astro.props;
const html = renderRichTextToHtml(content, { renderers });
---

<Fragment set:html={html} />
