---
import options from 'virtual:localess-options';
import { localessComponents } from 'virtual:import-localess-components';
import { localessEditable } from '@localess/client';
import { toCamelCase } from '../';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

export interface Props {
  data: { _id: string; _schema: string } & Record<string, unknown>;
  links?: unknown;
  references?: unknown;
  assets?: unknown;
  [prop: string]: unknown;
}

const { data, links, references, assets, ...restProps } = Astro.props;

if (!data) {
  throw new Error('LocalessComponent property "data" is not provided.');
}

const key = toCamelCase(data._schema);
const loader = localessComponents[key] || localessComponents['FallbackComponent'];

if (!loader) {
  throw new Error(
    `No component found for schema "${data._schema}".
      Make sure the component is:
      • Registered in your astro.config.mjs, or
      • Placed in the "/${options.componentsDir}/localess" folder, or
      • Enable the "enableFallbackComponent" option to handle missing components.`,
  );
}
const Component: AstroComponentFactory = await loader();
---

<Component data={data} links={links} references={references} assets={assets} {...localessEditable(data)} {...restProps} />
