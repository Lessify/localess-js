---
import LocalessComponent from './LocalessComponent.astro';
import type { Content } from '../models';

export interface Props {
  document: Content;
}

const { document } = Astro.props;

if (!document?.data) {
  throw new Error('LocalessDocument property "document.data" is not provided.');
}
---

<LocalessComponent data={document.data} links={document.links} references={document.references} assets={document.assets} />
