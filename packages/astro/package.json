{
  "name": "@localess/astro",
  "version": "3.4.1",
  "description": "AstroJS integration for Localess's API.",
  "keywords": ["localess", "sdk", "api", "client", "astro", "javascript", "typescript"],
  "author": "Lessify",
  "homepage": "https://github.com/Lessify/localess-js",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lessify/localess-js.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/Lessify/localess-js/issues"
  },
  "files": ["dist", "SKILL.md"],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./LocalessComponent.astro": "./dist/components/LocalessComponent.astro",
    "./LocalessDocument.astro": "./dist/components/LocalessDocument.astro",
    "./LocalessSync.astro": "./dist/components/LocalessSync.astro"
  },
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@localess/client": "*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "astro": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "engines": {
    "node": ">= 24.0.0"
  }
}
