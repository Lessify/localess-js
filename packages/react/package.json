{
  "name": "@localess/react",
  "version": "3.4.1",
  "description": "ReactJS JavaScript/TypeScript SDK for Localess's API.",
  "keywords": [
    "localess",
    "sdk",
    "api",
    "client",
    "react",
    "javascript",
    "typescript"
  ],
  "author": "Lessify",
  "homepage": "https://github.com/Lessify/localess-js",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lessify/localess-js.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Lessify/localess-js/issues"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.mjs",
      "require": "./dist/ssr/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "import": "./dist/rsc/index.mjs",
      "require": "./dist/rsc/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.mjs",
      "require": "./dist/vite/index.js"
    },
    "./vite/virtual-modules": {
      "types": "./dist/vite/virtual-modules.d.ts",
      "import": "./dist/vite/virtual-modules.mjs",
      "require": "./dist/vite/virtual-modules.js"
    }
  },
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "next": "^13 || ^14 || ^15 || ^16",
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@localess/client": "*",
    "@localess/model": "*",
    "@localess/richtext": "*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.9.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.0"
  },
  "engines": {
    "node": ">= 24.0.0"
  }
}
