{
  "name": "@localess/svelte",
  "version": "4.0.0",
  "description": "Svelte JavaScript/TypeScript SDK for Localess's API.",
  "keywords": [
    "localess",
    "sdk",
    "api",
    "client",
    "svelte",
    "javascript",
    "typescript"
  ],
  "author": "Lessify",
  "homepage": "https://github.com/Lessify/localess-js",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lessify/localess-js.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/Lessify/localess-js/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/__fixtures__",
    "SKILL.md"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run typecheck && npm run build:lib && publint",
    "build:lib": "svelte-kit sync && svelte-package",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@localess/client": "*",
    "@localess/model": "*",
    "@localess/richtext": "*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">= 24.0.0"
  }
}
