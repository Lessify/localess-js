{
  "name": "@localess/schema",
  "version": "3.4.1",
  "description": "Programmatic schema definitions for Localess with TypeScript content type inference.",
  "keywords": [
    "localess",
    "sdk",
    "schema",
    "cms",
    "javascript",
    "typescript"
  ],
  "author": "Lessify",
  "homepage": "https://github.com/Lessify/localess-js",
  "sideEffects": false,
  "files": [
    "dist",
    "SKILL.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lessify/localess-js.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/Lessify/localess-js/issues"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@localess/client": "*",
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.0"
  },
  "engines": {
    "node": ">= 24.0.0"
  }
}
