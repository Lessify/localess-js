---
import { getLivePayload, getLocalessClient } from '@localess/astro';
import LocalessDocument from '@localess/astro/LocalessDocument.astro';
import Layout from '../../layouts/Layout.astro';
import { LOCALES } from '@/shared/utils/locales.ts';

const { locale: segments } = Astro.params;
const localeSegments = segments ? segments.split('/') : [];
if (localeSegments.length > 1) {
  return Astro.redirect('/404');
}
const locale = localeSegments[0];
if (locale && !LOCALES.some(l => l.id === locale)) {
  return Astro.redirect('/404');
}

const preview = await getLivePayload(Astro);
const document = preview.data ? { data: preview.data } : await getLocalessClient().getContentBySlug('home', { locale: locale || undefined });
---

<Layout>
  <div class="flex flex-col w-full gap-8 mx-auto max-w-5xl">
    <header class="py-8">
      <nav class="flex justify-center">
        <ul class="flex rounded-full bg-white/90 px-3 text-sm font-medium text-zinc-800 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10">
          {
            LOCALES.map(item => {
              const isActive = (locale ?? '') === item.id;
              return (
                <li>
                  <a
                    class={`relative block px-3 py-2 transition hover:text-teal-500 dark:hover:text-teal-400${isActive ? ' text-teal-500 dark:text-teal-400' : ''}`}
                    href={item.id ? `/${item.id}` : '/'}
                    hreflang={item.id}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.name}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </header>
    <LocalessDocument document={document} />
  </div>
</Layout>
